# LinkedIn Session Cookie (Optional if using `python -m src.cli login`)
# To get your li_at cookie manually:
# 1. Open linkedin.com in your browser and log in
# 2. Press F12 -> Application -> Cookies -> https://www.linkedin.com
# 3. Find the cookie named `li_at` and paste its value below:
LINKEDIN_LI_AT=

# Optional proxy (HTTP or SOCKS5)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Request delay in seconds to avoid rate limiting
REQUEST_DELAY=1.5

# Connect the Docker container to an already logged-in Chrome on the Windows host.
CHROME_CDP_URL=http://host.docker.internal:9222
CHROME_CDP_TIMEOUT=15
